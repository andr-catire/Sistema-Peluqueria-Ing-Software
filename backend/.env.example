PORT=3000
# Neon Connect: pooling enabled; use the host containing -pooler for the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Neon Connect: pooling disabled; use the direct host for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"
JWT_SECRET="cambia-esto-por-una-clave-larga"
FRONTEND_URL="http://localhost:5173"
TELEFONO_PELUQUERIA="+0000000000"