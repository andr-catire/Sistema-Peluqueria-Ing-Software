# ============================================================================
# Configuración local del backend
#
# 1. Copia este archivo como backend/.env  (cp .env.example .env)
# 2. Completa los valores reales.
# 3. NO subas backend/.env a Git.
# 4. NO uses comillas: Spring las toma como parte del valor.
#
# Spring carga backend/.env automáticamente al ejecutar ./mvnw desde backend/
# gracias a spring.config.import=optional:file:.env[.properties].
# ============================================================================

# --- Servidor ---------------------------------------------------------------
# Puerto HTTP local. Déjalo en 3000 salvo que esté ocupado.
# En producción, el proveedor de hosting puede inyectar PORT automáticamente.
PORT=3000

# URL del frontend permitida por CORS.
# Local: http://localhost:5173 (Vite).
# Producción: la URL real del frontend (por ejemplo https://mi-frontend.vercel.app).
# Se obtiene del dominio donde se despliegue el frontend.
FRONTEND_URL=http://localhost:5173

# --- Neon / PostgreSQL ------------------------------------------------------
# Dónde obtenerlas: Neon Dashboard > tu proyecto > Connect.
#   Rama: development
#   Base: neondb
#   Rol: el rol de desarrollo (por ejemplo neondb_owner)
#
# DB_URL: cadena con Connection pooling ACTIVADO (host con "-pooler").
# DB_DIRECT_URL: cadena con Connection pooling DESACTIVADO (host directo, sin "-pooler").
# La aplicación usa DB_URL; Flyway usa DB_DIRECT_URL para aplicar migraciones.
#
# Neon entrega:  postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
# Spring necesita: jdbc:postgresql://HOST/BASE?sslmode=require
# El usuario y la contraseña van aparte, en DB_USER y DB_PASSWORD.
# Copia exactamente el host y los parámetros SSL que muestra Neon.
# Si aparecen errores de "prepared statement", usa también el host directo en DB_URL.
DB_URL=jdbc:postgresql://HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DB_DIRECT_URL=jdbc:postgresql://HOST.REGION.aws.neon.tech/neondb?sslmode=require

# Usuario y contraseña del rol de Neon.
# Se obtienen de la misma cadena de conexión o en Neon > Project > Roles.
DB_USER=
DB_PASSWORD=

# --- Administrador inicial --------------------------------------------------
# Solo se usa si todavía no existe ningún usuario con rol ADMIN.
# La contraseña debe tener 8 caracteres o más.
# Elige un correo y una contraseña del equipo; no los compartas ni los subas a Git.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Datos del negocio ------------------------------------------------------
# Teléfono corporativo que se muestra en la interfaz.
# Lo proporciona el dueño del salón. Nunca se escribe a mano en las vistas.
TELEFONO_PELUQUERIA=

# --- Diagnóstico ------------------------------------------------------------
# true solo para ver el SQL que genera Hibernate; false en uso normal.
JPA_SHOW_SQL=false

# --- Pendiente: autenticación JWT ------------------------------------------
# Se activará con la historia de inicio de sesión.
# Genera un secreto largo, por ejemplo: openssl rand -base64 48
# JWT_SECRET=
