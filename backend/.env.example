# Copia este archivo como ".env" (no se sube a Git) y completa los valores.
# IMPORTANTE: sin comillas. Spring toma las comillas como parte del valor.
PORT=3000
FRONTEND_URL=http://localhost:5173

# Neon. Formato JDBC: usuario y contraseña van APARTE.
#   postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require   ->   jdbc:postgresql://HOST/neondb?sslmode=require
# DB_URL: host con "-pooler" (la aplicación). DB_DIRECT_URL: host sin "-pooler" (Flyway).
# Si aparecen errores de "prepared statement", usa el host directo también en DB_URL.
DB_URL=jdbc:postgresql://HOST-pooler/neondb?sslmode=require
DB_DIRECT_URL=jdbc:postgresql://HOST/neondb?sslmode=require
DB_USER=
DB_PASSWORD=

# Administrador inicial (se crea solo si todavía no existe ningún ADMIN). Contraseña de 8+ caracteres.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

TELEFONO_PELUQUERIA=

# JWT_SECRET= (pendiente: se agrega con la historia de inicio de sesión)
