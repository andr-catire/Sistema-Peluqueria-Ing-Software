# Variables de entorno para el backend (Spring Boot)
# Copia este archivo a backend/.env para desarrollo local
PORT=3000
FRONTEND_URL=http://localhost:5173

# Base de datos PostgreSQL / Neon
DB_URL=jdbc:postgresql://localhost:5432/peluqueria
DB_DIRECT_URL=jdbc:postgresql://localhost:5432/peluqueria
DB_USER=postgres
DB_PASSWORD=postgres

# Administrador inicial (creado automáticamente si no existe en la BD)
APP_ADMIN_EMAIL=admin@peluqueria.com
APP_ADMIN_PASSWORD=Admin1234*

# Secreto para firma de tokens JWT (HS256)
JWT_SECRET=clave_secreta_para_desarrollo_local_segura_peluqueria_2026_ucab

# Teléfono del salón
TELEFONO_PELUQUERIA=+58 412 1234567

# Registro SQL en consola
JPA_SHOW_SQL=false
