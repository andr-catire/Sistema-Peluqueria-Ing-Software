# URL base de la API Spring Boot, terminada en /api.
#
# Local:      http://localhost:3000/api
#             (3000 es el PORT del backend y /api el prefijo de sus rutas)
# Producción: la URL pública del backend + /api
#             (por ejemplo https://mi-backend.onrender.com/api)
#
# Copia este archivo como frontend/.env y reinicia Vite después de cambiarlo.
# Vite solo expone en el navegador las variables que empiezan por VITE_.
VITE_API_URL=http://localhost:3000/api
